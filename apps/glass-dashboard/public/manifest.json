{
  "id": "0199c5e8-7a3e-7d19-ae2f-3b4ce4d7a301",
  "name": "Glass Dashboard",
  "version": "0.1.6",
  "description": "A liquid-glass dashboard with clock, weather and playback.",
  "categories": [
    "dashboards",
    "clocks-weather"
  ],
  "permissions": [
    "net.fetch"
  ],
  "settings": "settings/index.html",
  "art": {
    "heroPx": 248,
    "thumbPx": 96
  },
  "config": [
    {
      "type": "enum",
      "data": {
        "key": "clockFace",
        "label": "Clock face",
        "choices": [
          "fuzzy",
          "binary",
          "analog",
          "digital",
          "pixel"
        ],
        "choiceLabels": {
          "fuzzy": "Fuzzy",
          "binary": "Binary",
          "analog": "Analog",
          "digital": "Digital",
          "pixel": "Pixel"
        },
        "default": "digital"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "fuzzyClockPrecision",
        "label": "Fuzzy clock precision",
        "description": "Choose how broadly the fuzzy clock describes the time",
        "choices": [
          "daypart",
          "quarter-hour",
          "five-minute"
        ],
        "choiceLabels": {
          "daypart": "Very fuzzy (morning, afternoon)",
          "quarter-hour": "Fuzzy (quarter hours)",
          "five-minute": "Less fuzzy (5-minute phrases)"
        },
        "default": "daypart"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "backgroundTheme",
        "label": "Background theme",
        "description": "Choose a gradient or solid dashboard background",
        "choices": [
          "midnight",
          "ocean",
          "aurora",
          "sunset",
          "solid-charcoal",
          "solid-navy",
          "solid-forest"
        ],
        "choiceLabels": {
          "midnight": "Midnight gradient",
          "ocean": "Ocean gradient",
          "aurora": "Aurora gradient",
          "sunset": "Sunset gradient",
          "solid-charcoal": "Solid charcoal",
          "solid-navy": "Solid navy",
          "solid-forest": "Solid forest"
        },
        "default": "midnight"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "temperatureUnit",
        "label": "Temperature",
        "choices": [
          "celsius",
          "fahrenheit"
        ],
        "choiceLabels": {
          "celsius": "Celsius",
          "fahrenheit": "Fahrenheit"
        },
        "default": "celsius"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "dashboardLayout",
        "label": "Widget layout",
        "description": "Choose how the clock, weather and playback widgets are arranged",
        "choices": [
          "balanced",
          "weather-focus",
          "side-by-side",
          "stacked"
        ],
        "choiceLabels": {
          "balanced": "Clock and weather",
          "weather-focus": "Weather focus",
          "side-by-side": "Side by side",
          "stacked": "Stacked"
        },
        "default": "balanced"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "widgetSpacing",
        "label": "Widget spacing",
        "choices": [
          "compact",
          "balanced",
          "spacious"
        ],
        "choiceLabels": {
          "compact": "Compact",
          "balanced": "Balanced",
          "spacious": "Spacious"
        },
        "default": "balanced"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "clockSize",
        "label": "Clock size",
        "choices": [
          "compact",
          "balanced",
          "large"
        ],
        "choiceLabels": {
          "compact": "Compact",
          "balanced": "Balanced",
          "large": "Large"
        },
        "default": "balanced"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "weatherSize",
        "label": "Weather size",
        "choices": [
          "compact",
          "balanced",
          "large"
        ],
        "choiceLabels": {
          "compact": "Compact",
          "balanced": "Balanced",
          "large": "Large"
        },
        "default": "balanced"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "playerSize",
        "label": "Playback size",
        "choices": [
          "compact",
          "balanced",
          "large"
        ],
        "choiceLabels": {
          "compact": "Compact",
          "balanced": "Balanced",
          "large": "Large"
        },
        "default": "balanced"
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "showClock",
        "label": "Show clock",
        "default": true
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "showWeather",
        "label": "Show weather",
        "default": true
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "showPlayback",
        "label": "Show playback",
        "description": "Show playback controls when music is playing",
        "default": true
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "showSoundtrack",
        "label": "Show Soundtrack",
        "description": "Show Soundtrack's now-playing information separately from playback controls",
        "default": true
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "lowPowerMode",
        "label": "Reduce visual effects",
        "description": "Disable backdrop blur and ambient effects for lower-power devices",
        "default": false
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "weatherSharingEnabled",
        "label": "Enable weather data sharing",
        "description": "Allow your city name and resolved coordinates to be sent to Open-Meteo for weather data",
        "default": false
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "alwaysShowPlayback",
        "label": "Always show playback",
        "description": "Keep the player visible when nothing is playing",
        "default": false
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "soundtrackEnabled",
        "label": "Enable Soundtrack monitoring",
        "description": "Poll the configured status URL every 5 seconds. Artwork is fetched from Soundtrack's HTTPS image CDN; redirects are rejected.",
        "default": false
      }
    },
    {
      "type": "string",
      "data": {
        "key": "soundtrackUrl",
        "label": "Soundtrack display URL",
        "description": "Soundtrack Now Playing page URL, such as https://display.soundtrackyourbrand.com/BEEPLE. Its zone name is used to fetch the current track.",
        "pattern": null,
        "minLength": null,
        "maxLength": null,
        "default": "https://display.soundtrackyourbrand.com/BEEPLE"
      }
    }
  ]
}
